# Admin override (optional)
ADMIN_USER=admin
ADMIN_PASS=admin123
ADMIN_EMAIL=admin@example.com
REPORT_EMAIL=reports@example.com

# Persistent storage
# Use DATA_DIR with a Render persistent disk mount path, for example /var/data.
DATA_DIR=./data

# Optional Postgres storage for admin profile and attendance changes.
# If set, admin account changes, late cutoff settings, and attendance records are stored in the database.
DATABASE_URL=
DATABASE_SSL=false

# SMTP sender defaults (optional - these can also be saved from Admin Account > Sender Settings)
# Use a dedicated sender email account, not a personal email account.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=PrincetonReport@gmail.com
SMTP_PASS=your-sender-app-password
SMTP_FROM=Event Check-In <PrincetonReport@gmail.com>
SMTP_SECURE=false
SMTP_TIMEOUT_MS=10000
DAILY_REPORT_SEND_AFTER_HOUR=18
