# Admin override (optional)
ADMIN_USER=admin
ADMIN_PASS=admin123
ADMIN_EMAIL=admin@example.com

# Persistent storage
# Use DATA_DIR with a Render persistent disk mount path, for example /var/data.
DATA_DIR=./data

# Optional Postgres storage for admin profile and attendance changes.
# If set, admin account changes, late cutoff settings, and attendance records are stored in the database.
DATABASE_URL=
DATABASE_SSL=false

# SMTP (optional - for password reminders and late reason emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
SMTP_FROM=Event Check-In <noreply@example.com>
SMTP_SECURE=false
